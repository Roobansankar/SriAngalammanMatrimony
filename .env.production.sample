# =============================================================================
# PRODUCTION ENVIRONMENT - VPS (HTTPS)
# =============================================================================
# Copy this to .env on your production VPS
# Domain: sriangalammanmatrimony.com
# =============================================================================

NODE_ENV=production
PORT=5000

# Database
DB_HOST=db
DB_USER=matrimony
DB_PASS=YOUR_SECURE_DB_PASSWORD
DB_NAME=sriang

# Public URLs (HTTPS domain)
API_BASE_URL=https://sriangalammanmatrimony.com
BASE_URL=https://sriangalammanmatrimony.com

# Security - IMPORTANT: Change this to a secure random string!
JWT_SECRET=YOUR_SECURE_JWT_SECRET_CHANGE_THIS_TO_64_CHARS

# SMTP
SMTP_USER=sriangalammanspsk2020@gmail.com
SMTP_PASS=your-smtp-app-password
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465

# Razorpay (Live keys)
RAZORPAY_KEY_ID=your-live-razorpay-key
RAZORPAY_KEY_SECRET=your-live-razorpay-secret

# Frontend (uses same-origin since nginx proxies /api)
REACT_APP_API_BASE=
REACT_APP_SOCKET_URL=

# MySQL Container
MYSQL_ROOT_PASSWORD=YOUR_SECURE_ROOT_PASSWORD
MYSQL_DATABASE=sriang
MYSQL_USER=matrimony
MYSQL_PASSWORD=YOUR_SECURE_DB_PASSWORD

# Persistent data on VPS
MYSQL_DATA_DIR=/var/lib/matrimony/mysql
